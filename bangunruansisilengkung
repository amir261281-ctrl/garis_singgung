                ctx.beginPath(); ctx.moveTo(cx, cy); ctx.lineTo(px, py); ctx.stroke(); ctx.setLineDash([]);
                // Tangent point A
                const ax = cx + r * Math.sin(angle);
                const ay = cy - r * Math.cos(angle);
                ctx.fillStyle = '#f43f5e'; ctx.beginPath(); ctx.arc(ax, ay, 4, 0, Math.PI*2); ctx.fill();
                ctx.fillText("A", ax - 5, ay - 10);
                // Tangent Line PA
                ctx.strokeStyle = '#34d399'; ctx.lineWidth = 3;
                ctx.beginPath(); ctx.moveTo(px, py); ctx.lineTo(ax, ay); ctx.stroke();
                // Radius OA
                ctx.strokeStyle = '#f43f5e'; ctx.lineWidth = 2;
                ctx.beginPath(); ctx.moveTo(cx, cy); ctx.lineTo(ax, ay); ctx.stroke();

            } else if (type === 'gspd' || type === 'gspl') {
                const R = currentSliderVals.R * 6;
                const r = currentSliderVals.r * 6;
                const p = currentSliderVals.p * 9;
                const c2x = cx + p, c2y = cy;

                // Circle 1
                ctx.beginPath(); ctx.arc(cx, cy, R, 0, Math.PI*2); ctx.strokeStyle = '#38bdf8'; ctx.stroke();
                ctx.fillStyle = '#fbbf24'; ctx.beginPath(); ctx.arc(cx, cy, 3, 0, Math.PI*2); ctx.fill();
                // Circle 2
                ctx.beginPath(); ctx.arc(c2x, c2y, r, 0, Math.PI*2); ctx.strokeStyle = '#a78bfa'; ctx.stroke();
                ctx.fillStyle = '#fbbf24'; ctx.beginPath(); ctx.arc(c2x, c2y, 3, 0, Math.PI*2); ctx.fill();
                // Line P1-P2 (p)
                ctx.strokeStyle = '#64748b'; ctx.setLineDash([4,4]);
                ctx.beginPath(); ctx.moveTo(cx, cy); ctx.lineTo(c2x, c2y); ctx.stroke(); ctx.setLineDash([]);

                ctx.strokeStyle = '#34d399'; ctx.lineWidth = 3;
                if (type === 'gspd') {
                    // Inner Tangent Line
                    const k = (R + r) / p;
                    if (k <= 1) {
                        const ang = Math.asin(k);
                        const t1x = cx + R * Math.sin(ang);
                        const t1y = cy - R * Math.cos(ang);
                        const t2x = c2x - r * Math.sin(ang);
                        const t2y = c2y + r * Math.cos(ang);
                        ctx.beginPath(); ctx.moveTo(t1x, t1y); ctx.lineTo(t2x, t2y); ctx.stroke();
                    }
                } else {
                    // Outer Tangent Line
                    const diff = R - r;
                    const k = diff / p;
                    if (k <= 1) {
                        const ang = Math.asin(k);
                        const t1x = cx + R * Math.sin(ang);
                        const t1y = cy - R * Math.cos(ang);
                        const t2x = c2x + r * Math.sin(ang);
                        const t2y = c2y - r * Math.cos(ang);
                        ctx.beginPath(); ctx.moveTo(t1x, t1y); ctx.lineTo(t2x, t2y); ctx.stroke();
                    }
                }
            }
        }

        // 3D THREE.JS DRAWING FUNCTIONS
        function draw3D(type) {
            const holder = document.getElementById('threejs-holder');
            if (!holder) return;

            scene = new THREE.Scene();
            camera = new THREE.PerspectiveCamera(45, holder.clientWidth / holder.clientHeight, 0.1, 1000);
            renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
            renderer.setSize(holder.clientWidth, holder.clientHeight);
            holder.appendChild(renderer.domElement);

            // Lighting
            const ambientLight = new THREE.AmbientLight(0xffffff, 0.7);
            scene.add(ambientLight);
            const dirLight = new THREE.DirectionalLight(0x0d9488, 0.8);
            dirLight.position.set(5, 10, 7);
            scene.add(dirLight);

            // Mesh Generation
            const material = new THREE.MeshPhongMaterial({
                color: 0x14b8a6,
                shininess: 80,
                wireframe: false,
                transparent: true,
                opacity: 0.85
            });

            let geometry;
            const r = currentSliderVals.r * 0.3;
            const t = (currentSliderVals.t || 10) * 0.3;

            if (type === 'tabung') {
                geometry = new THREE.CylinderGeometry(r, r, t, 32);
            } else if (type === 'kerucut') {
                geometry = new THREE.ConeGeometry(r, t, 32);
            } else if (type === 'bola') {
                geometry = new THREE.SphereGeometry(r, 32, 32);
            }

            currentMesh = new THREE.Mesh(geometry, material);
            scene.add(currentMesh);

            // Wireframe Overlay
            const wireGeo = new THREE.WireframeGeometry(geometry);
            const wireMat = new THREE.LineBasicMaterial({ color: 0xffffff, opacity: 0.3, transparent: true });
            const wireframe = new THREE.LineSegments(wireGeo, wireMat);
            currentMesh.add(wireframe);

            camera.position.set(0, 5, 12);
            controls = new THREE.OrbitControls(camera, renderer.domElement);
            controls.enableDamping = true;

            function animate() {
                requestAnimationFrame(animate);
                if (currentMesh) currentMesh.rotation.y += 0.005;
                controls.update();
                renderer.render(scene, camera);
            }
            animate();
        }

        // EXAMPLES FILTER & RENDER
        function renderExamples(lvlFilter) {
            const topic = topicsData[currentTopicIdx];
            const container = document.getElementById('examples-list');

            let filtered = topic.examples;
            if (lvlFilter !== 'all') {
                filtered = topic.examples.filter(e => e.level === lvlFilter);
            }

            container.innerHTML = filtered.map(e => `
                <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm">
                    <div class="flex items-center justify-between mb-3">
                        <span class="px-2.5 py-1 text-xs font-bold rounded-md ${
                            e.level === 1 ? 'bg-emerald-100 text-emerald-800' :
                            e.level === 2 ? 'bg-amber-100 text-amber-800' : 'bg-rose-100 text-rose-800'
                        }">Level ${e.level} • ${e.level === 1 ? 'Dasar' : e.level === 2 ? 'Sedang' : 'HOTS / Tantangan'}</span>
                        <h4 class="font-bold text-slate-900 text-sm">${e.title}</h4>
                    </div>
                    <p class="text-sm font-semibold text-slate-800 mb-3">${e.question}</p>
                    <details class="group bg-slate-50 p-3 rounded-xl border border-slate-200">
                        <summary class="cursor-pointer text-xs font-bold text-teal-700 flex items-center justify-between">
                            <span>Lihat Langkah Pembahasan</span>
                            <i data-lucide="chevron-down" class="w-4 h-4 transition-transform group-open:rotate-180"></i>
                        </summary>
                        <div class="mt-3 space-y-1.5 text-xs text-slate-600 font-mono border-t pt-2 border-slate-200">
                            ${e.steps.map(s => `<p>${s}</p>`).join('')}
                        </div>
                    </details>
                </div>
            `).join('');

            lucide.createIcons();
        }

        function filterExamples(lvl) {
            document.querySelectorAll('.ex-filter-btn').forEach(b => {
                b.classList.remove('bg-teal-600', 'text-white');
                b.classList.add('bg-slate-100', 'text-slate-600');
            });
            event.target.classList.add('bg-teal-600', 'text-white');
            renderExamples(lvl);
        }

        // QUIZ SYSTEM LOGIC
        function loadQuizLevel(lvl) {
            activeQuizLvl = lvl;
            [1,2,3].forEach(l => {
                const btn = document.getElementById(`quiz-lvl-${l}`);
                btn.className = `quiz-lvl-btn px-3 py-1.5 text-xs font-bold rounded-lg ${l === lvl ? 'bg-teal-600 text-white' : 'bg-slate-200 text-slate-700'}`;
            });

            const topic = topicsData[currentTopicIdx];
            const questions = topic.quizzes[lvl] || [];
            const container = document.getElementById('quiz-container');

            if (questions.length === 0) {
                container.innerHTML = `<p class="text-center text-sm text-slate-500 py-8">Soal kuis untuk level ini sedang disiapkan.</p>`;
                return;
            }

            container.innerHTML = questions.map((q, qIdx) => `
                <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm" id="q-card-${qIdx}">
                    <p class="text-sm font-bold text-slate-900 mb-4">Soal ${qIdx + 1}: ${q.q}</p>
                    <div class="space-y-2 mb-4">
                        ${q.options.map((opt, oIdx) => `
                            <label class="flex items-center p-3 rounded-xl border border-slate-200 hover:bg-slate-50 cursor-pointer text-sm">
                                <input type="radio" name="q_${qIdx}" value="${oIdx}" class="accent-teal-600 w-4 h-4 mr-3">
                                <span>${opt}</span>
                            </label>
                        `).join('')}
                    </div>
                    <button onclick="checkAnswer(${qIdx}, ${q.ans})" class="px-4 py-2 bg-slate-900 hover:bg-teal-600 text-white text-xs font-bold rounded-xl transition">
                        Periksa Jawaban
                    </button>
                    <div id="q-feedback-${qIdx}" class="hidden mt-4 p-3 rounded-xl text-xs font-semibold"></div>
                </div>
            `).join('');
        }

        function checkAnswer(qIdx, correctIdx) {
            const selected = document.querySelector(`input[name="q_${qIdx}"]:checked`);
            const feedback = document.getElementById(`q-feedback-${qIdx}`);
            const topic = topicsData[currentTopicIdx];
            const qData = topic.quizzes[activeQuizLvl][qIdx];

            feedback.classList.remove('hidden', 'bg-emerald-100', 'text-emerald-900', 'bg-rose-100', 'text-rose-900');

            if (!selected) {
                feedback.classList.add('bg-rose-100', 'text-rose-900');
                feedback.innerText = "Silakan pilih salah satu jawaban terlebih dahulu!";
                return;
            }

            if (parseInt(selected.value) === correctIdx) {
                feedback.classList.add('bg-emerald-100', 'text-emerald-900');
                feedback.innerHTML = `✅ <strong>Jawaban Benar!</strong><br><span class="font-mono mt-1 block">${qData.exp}</span>`;
            } else {
                feedback.classList.add('bg-rose-100', 'text-rose-900');
                feedback.innerHTML = `❌ <strong>Jawaban Kurang Tepat.</strong><br><span class="font-mono mt-1 block">Pembahasan: ${qData.exp}</span>`;
            }
        }
    </script>
