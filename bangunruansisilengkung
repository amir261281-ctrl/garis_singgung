    <!-- SCRIPT DATA & LOGIKA APLIKASI -->
    <script>
        // DATA APLIKASI UNTUK 6 TOPIK GEOMETRI
        const topicsData = [
            {
                id: 'gsl',
                title: 'Garis Singgung Lingkaran',
                badge: 'Garis Singgung (2D)',
                summary: `
                    <div class="bg-amber-50 border-l-4 border-amber-500 p-4 rounded-r-xl mb-4">
                        <h4 class="font-bold text-amber-900 mb-1">Konsep Dasar</h4>
                        <p class="text-sm text-amber-800">Garis singgung lingkaran adalah garis yang memotong lingkaran tepat di <strong>satu titik</strong> (titik singgung). Garis singgung selalu <strong>tegak lurus ($90^\circ$)</strong> terhadap jari-jari yang melalui titik singgung tersebut.</p>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm">
                            <h4 class="font-bold text-slate-900 mb-2 text-sm border-b pb-1">Sifat Utama Garis Singgung:</h4>
                            <ul class="list-disc list-inside text-sm text-slate-600 space-y-1">
                                <li>Tegak lurus terhadap jari-jari di titik singgung.</li>
                                <li>Dari satu titik luar lingkaran, dapat dibuat <strong>2 garis singgung</strong> yang sama panjang.</li>
                                <li>Membentuk segitiga siku-siku dengan jari-jari dan jarak titik ke pusat.</li>
                            </ul>
                        </div>
                        <div class="bg-teal-900 text-white p-4 rounded-xl shadow-sm">
                            <h4 class="font-bold text-teal-300 mb-2 text-sm border-b border-teal-700 pb-1">Rumus Utama (Pythagoras):</h4>
                            <div class="text-center py-2 text-lg font-mono font-bold text-amber-300">
                                d = √(p² - r²)
                            </div>
                            <p class="text-xs text-teal-200 mt-2">Keterangan:<br>
                            • <strong>d</strong> = Panjang garis singgung<br>
                            • <strong>p</strong> = Jarak titik luar ke pusat lingkaran<br>
                            • <strong>r</strong> = Jari-jari lingkaran</p>
                        </div>
                    </div>
                `,
                controls: [
                    { id: 'r', label: 'Jari-jari (r)', min: 3, max: 12, value: 6, step: 1, unit: 'cm' },
                    { id: 'p', label: 'Jarak Pusat ke Titik (p)', min: 7, max: 25, value: 10, step: 1, unit: 'cm' }
                ],
                calc: (vals) => {
                    const r = vals.r;
                    const p = Math.max(vals.p, r + 1);
                    const d = Math.sqrt(p*p - r*r);
                    return [
                        `Panjang Garis Singgung (d) = <strong>${d.toFixed(2)} cm</strong>`,
                        `Luas Segitiga OAP = <strong>${(0.5 * r * d).toFixed(2)} cm²</strong>`
                    ];
                },
                examples: [
                    {
                        level: 1,
                        title: 'Menghitung Panjang Garis Singgung',
                        question: 'Sebuah lingkaran berpusat di O memiliki jari-jari r = 6 cm. Titik P berada di luar lingkaran dengan jarak OP = 10 cm. Hitunglah panjang garis singgung PA!',
                        steps: [
                            'Diketahui: r = 6 cm, p = 10 cm.',
                            'Garis singgung tegak lurus dengan jari-jari, sehingga berlaku Teorema Pythagoras:',
                            'PA = √(OP² - OA²)',
                            'PA = √(10² - 6²)',
                            'PA = √(100 - 36) = √64 = 8 cm.',
                            'Jadi, panjang garis singgung PA adalah 8 cm.'
                        ]
                    },
                    {
                        level: 2,
                        title: 'Menentukan Jari-jari & Luas Layang-Layang',
                        question: 'Panjang garis singgung dari titik P ke lingkaran pusat O adalah 24 cm. Jika jarak OP = 25 cm, hitunglah jari-jari lingkaran dan luas layang-layang OAPB!',
                        steps: [
                            'Diketahui: d = 24 cm, p = 25 cm.',
                            '1. Menghitung Jari-Jari (r): r = √(p² - d²) = √(25² - 24²) = √(625 - 576) = √49 = 7 cm.',
                            '2. Luas ΔOAP = 1/2 × r × d = 1/2 × 7 × 24 = 84 cm².',
                            '3. Luas Layang-Layang OAPB = 2 × Luas ΔOAP = 2 × 84 = 168 cm².'
                        ]
                    },
                    {
                        level: 3,
                        title: 'HOTS: Panjang Tali Busur AB',
                        question: 'Dari titik P di luar lingkaran berpusat di O dibuat dua garis singgung PA dan PB. Jari-jari r = 9 cm dan OP = 15 cm. Tentukan panjang tali busur AB yang menghubungkan kedua titik singgung!',
                        steps: [
                            '1. Cari panjang garis singgung PA: PA = √(15² - 9²) = √(225 - 81) = √144 = 12 cm.',
                            '2. Luas ΔOAP = 1/2 × OA × AP = 1/2 × 9 × 12 = 54 cm².',
                            '3. Garis OP tegak lurus membagi dua tali busur AB di titik T. Luas ΔOAP juga = 1/2 × OP × AT.',
                            '4. Maka: 54 = 1/2 × 15 × AT  =>  AT = (54 × 2) / 15 = 7.2 cm.',
                            '5. Panjang Tali Busur AB = 2 × AT = 2 × 7.2 = 14.4 cm.'
                        ]
                    }
                ],
                quizzes: {
                    1: [
                        { q: "Jika jari-jari lingkaran 5 cm dan jarak titik ke pusat 13 cm, berapakah panjang garis singgungnya?", options: ["10 cm", "12 cm", "14 cm", "15 cm"], ans: 1, exp: "d = √(13² - 5²) = √(169 - 25) = √144 = 12 cm." }
                    ],
                    2: [
                        { q: "Panjang garis singgung dari titik P adalah 15 cm dan jari-jari lingkaran 8 cm. Berapa jarak titik P ke pusat?", options: ["17 cm", "20 cm", "23 cm", "25 cm"], ans: 0, exp: "p = √(15² + 8²) = √(225 + 64) = √289 = 17 cm." }
                    ],
                    3: [
                        { q: "Titik P di luar lingkaran ber-jari-jari 10 cm. Jika panjang garis singgung PA = 24 cm, berapa luas layang-layang garis singgung OAPB?", options: ["120 cm²", "240 cm²", "480 cm²", "300 cm²"], ans: 1, exp: "Luas 1 segitiga = 1/2 × 10 × 24 = 120 cm². Luas layang-layang = 2 × 120 = 240 cm²." }
                    ]
                }
            },
            {
                id: 'gspd',
                title: 'Garis Singgung Persekutuan Dalam (GSPD)',
                badge: 'GSPD (2D)',
                summary: `
                    <div class="bg-amber-50 border-l-4 border-amber-500 p-4 rounded-r-xl mb-4">
                        <h4 class="font-bold text-amber-900 mb-1">Konsep GSPD</h4>
                        <p class="text-sm text-amber-800">GSPD adalah garis singgung yang <strong>memotong segmen garis</strong> yang menghubungkan titik pusat kedua lingkaran. Posisi garis bersilangan di antara kedua lingkaran.</p>
                    </div>
                    <div class="bg-teal-900 text-white p-4 rounded-xl shadow-sm mb-4">
                        <h4 class="font-bold text-teal-300 mb-2 text-sm border-b border-teal-700 pb-1">Rumus Utama GSPD:</h4>
                        <div class="text-center py-2 text-xl font-mono font-bold text-amber-300">
                            d = √(p² - (R + r)²)
                        </div>
                        <p class="text-xs text-teal-200 mt-2">Keterangan: <strong>d</strong> = GSPD | <strong>p</strong> = Jarak Pusat (P1-P2) | <strong>R</strong> = Jari-jari Besar | <strong>r</strong> = Jari-jari Kecil</p>
                    </div>
                `,
                controls: [
                    { id: 'R', label: 'Jari-jari R1 (R)', min: 4, max: 12, value: 7, step: 1, unit: 'cm' },
                    { id: 'r', label: 'Jari-jari R2 (r)', min: 2, max: 8, value: 3, step: 1, unit: 'cm' },
                    { id: 'p', label: 'Jarak Pusat (p)', min: 11, max: 30, value: 26, step: 1, unit: 'cm' }
                ],
                calc: (vals) => {
                    const R = vals.R;
                    const r = vals.r;
                    const p = Math.max(vals.p, R + r + 1);
                    const sumR = R + r;
                    const d = Math.sqrt(p*p - sumR*sumR);
                    return [
                        `Jumlah Jari-Jari (R + r) = <strong>${sumR} cm</strong>`,
                        `Panjang GSPD (d) = <strong>${d.toFixed(2)} cm</strong>`
                    ];
                },
                examples: [
                    {
                        level: 1,
                        title: 'Menghitung Panjang GSPD',
                        question: 'Dua lingkaran memiliki jari-jari R = 7 cm dan r = 3 cm. Jarak antara kedua pusat lingkaran p = 26 cm. Hitunglah panjang garis singgung persekutuan dalam (d)!',
                        steps: [
                            'Diketahui: R = 7 cm, r = 3 cm, p = 26 cm.',
                            'Rumus: d = √(p² - (R + r)²)',
                            'd = √(26² - (7 + 3)²) = √(26² - 10²)',
                            'd = √(676 - 100) = √576 = 24 cm.',
                            'Jadi, panjang GSPD adalah 24 cm.'
                        ]
                    },
                    {
                        level: 2,
                        title: 'Mencari Jari-jari Lingkaran Kedua',
                        question: 'Panjang GSPD dua lingkaran adalah 12 cm dan jarak kedua pusatnya 13 cm. Jika jari-jari lingkaran besar R = 3 cm, tentukan jari-jari lingkaran kecil (r)!',
                        steps: [
                            'Diketahui: d = 12 cm, p = 13 cm, R = 3 cm.',
                            '(R + r)² = p² - d²',
                            '(3 + r)² = 13² - 12² = 169 - 144 = 25',
                            '3 + r = √25 = 5  =>  r = 5 - 3 = 2 cm.',
                            'Jadi, jari-jari lingkaran kecil adalah 2 cm.'
                        ]
                    },
                    {
                        level: 3,
                        title: 'HOTS: Aplikasi Rantai Sepeda Silang',
                        question: 'Dua roda berpusat dengan jarak 50 cm dihubungkan oleh rantai bersilang (konsep GSPD). Jari-jari roda besar 18 cm dan roda kecil 12 cm. Hitung panjang garis rantai bersilang d dan selisihnya jika dipasang tidak bersilang (GSPL)!',
                        steps: [
                            '1. GSPD (d): R+r = 18+12 = 30 cm. d = √(50² - 30²) = √(2500 - 900) = √1600 = 40 cm.',
                            '2. GSPL (l): R-r = 18-12 = 6 cm. l = √(50² - 6²) = √(2500 - 36) = √2464 ≈ 49.64 cm.',
                            '3. Selisih panjang garis rantai = 49.64 - 40 = 9.64 cm.'
                        ]
                    }
                ],
                quizzes: {
                    1: [
                        { q: "Dua lingkaran R=8 cm dan r=4 cm berjarak pusat 20 cm. Berapa panjang GSPD?", options: ["16 cm", "15 cm", "12 cm", "18 cm"], ans: 0, exp: "d = √(20² - (8+4)²) = √(400 - 144) = √256 = 16 cm." }
                    ],
                    2: [
                        { q: "Panjang GSPD = 24 cm, R = 6 cm, r = 4 cm. Berapakah jarak pusat kedua lingkaran?", options: ["25 cm", "26 cm", "28 cm", "30 cm"], ans: 1, exp: "p = √(24² + (6+4)²) = √(576 + 100) = √676 = 26 cm." }
                    ],
                    3: [
                        { q: "Jarak pusat dua lingkaran 15 cm. Panjang GSPD 12 cm. Jika R = 6 cm, berapakah r?", options: ["2 cm", "3 cm", "4 cm", "5 cm"], ans: 1, exp: "R+r = √(15² - 12²) = √81 = 9 cm. r = 9 - 6 = 3 cm." }
                    ]
                }
            },
            {
                id: 'gspl',
                title: 'Garis Singgung Persekutuan Luar (GSPL)',
                badge: 'GSPL (2D)',
                summary: `
                    <div class="bg-amber-50 border-l-4 border-amber-500 p-4 rounded-r-xl mb-4">
                        <h4 class="font-bold text-amber-900 mb-1">Konsep GSPL</h4>
                        <p class="text-sm text-amber-800">GSPL adalah garis singgung yang <strong>tidak memotong</strong> segmen garis penghubung kedua titik pusat. Posisi garis sejajar berada di sisi luar kedua lingkaran.</p>
                    </div>
                    <div class="bg-teal-900 text-white p-4 rounded-xl shadow-sm mb-4">
                        <h4 class="font-bold text-teal-300 mb-2 text-sm border-b border-teal-700 pb-1">Rumus Utama GSPL:</h4>
                        <div class="text-center py-2 text-xl font-mono font-bold text-amber-300">
                            l = √(p² - (R - r)²)
                        </div>
                        <p class="text-xs text-teal-200 mt-2">Keterangan: <strong>l</strong> = GSPL | <strong>p</strong> = Jarak Pusat | <strong>R</strong> = Jari-jari Besar | <strong>r</strong> = Jari-jari Kecil</p>
                    </div>
                `,
                controls: [
                    { id: 'R', label: 'Jari-jari Besar (R)', min: 5, max: 15, value: 14, step: 1, unit: 'cm' },
                    { id: 'r', label: 'Jari-jari Kecil (r)', min: 1, max: 10, value: 2, step: 1, unit: 'cm' },
                    { id: 'p', label: 'Jarak Pusat (p)', min: 13, max: 30, value: 20, step: 1, unit: 'cm' }
                ],
                calc: (vals) => {
                    const R = vals.R;
                    const r = Math.min(vals.r, R - 1);
                    const p = Math.max(vals.p, R + r + 1);
                    const diffR = R - r;
                    const l = Math.sqrt(p*p - diffR*diffR);
                    return [
                        `Selisih Jari-Jari (R - r) = <strong>${diffR} cm</strong>`,
                        `Panjang GSPL (l) = <strong>${l.toFixed(2)} cm</strong>`
                    ];
